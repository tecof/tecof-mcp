# @tecof/mcp — tema reposunun kökündeki .env (ya da .env.local) dosyasına kopyalayın.
# process.env'de tanımlı olan değerler bu dosyadakileri EZER.

# Backend adresi (NEXT_PUBLIC_BASE_URL tanımlıysa o da kullanılır)
TECOF_API_URL=https://api.tecof.com

# Global tema id'si (NEXT_PUBLIC_THEME_ID tanımlıysa o da kullanılır; yoksa mağazanın aktif teması)
TECOF_THEME_ID=

# Panelden üretilen kişisel erişim anahtarı (Ayarlar → Geliştirici / API Anahtarları). Zorunlu.
TECOF_API_TOKEN=tcf_...

# Yerel önizleme adresi (varsayılan http://localhost:3000)
# TECOF_LOCAL_URL=http://localhost:3000

# Tema reposu başka bir dizindeyse (varsayılan: CLAUDE_PROJECT_DIR ya da cwd)
# TECOF_PROJECT_DIR=/path/to/tecof-theme-xyz

# Çalışma modu (0.2.0): local (varsayılan — araçlar pakette) | remote (araç kataloğu
# backend'in Tools API'sinden gelir; list_components/validate_document yerel, create/update_page hibrit)
# TECOF_MCP_MODE=remote

# remote modda yalnız bu modüllerin araçları (virgülle): pages,cms,media,products,domains,general
# TECOF_TOOLSETS=pages,cms
